# systemd unit for AlpacaCryptoTrader.
# Installed by deploy/install_service.sh, which fills in __USER__ and __APP_DIR__.

[Unit]
Description=AlpacaCryptoTrader
After=network-online.target
Wants=network-online.target
# Never give up: an internet or exchange outage must not leave the bot off.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python main.py
Environment=PYTHONUNBUFFERED=1

# Restart on crashes and on dead streams; `systemctl stop` does not trigger a restart.
# Back off from 30 s to 10 min between attempts so a long outage (or bad keys)
# retries quietly instead of hammering the API.
Restart=always
RestartSec=30
RestartSteps=10
RestartMaxDelaySec=600

# main.py handles SIGTERM: it stops the streams and cancels open entry orders.
# Give that time to reach Alpaca before systemd falls back to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=60

# Light hardening: read-only system, writable logs/ only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/logs

[Install]
WantedBy=multi-user.target
