# Exchange: "alpaca" (paper or live, long only) or "coinbase" (market data only for now)
BROKER=alpaca

# Coins to trade: comma-separated list, or "all" for every tradable USD coin on the broker
SYMBOLS=BTC/USD,ETH/USD

# Short entries in downtrends. Ignored (stays long-only) when the broker can't short.
ENABLE_SHORT_SELLING=false

# Alpaca API credentials
# Get these from https://alpaca.markets (paper trading is free)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to "true" for paper trading (safe, no real money), "false" for live
ALPACA_PAPER=true

# Coinbase (framework only; see brokers/coinbase.py)
# "spot" = long only, "futures" = US perpetual-style futures, long and short
COINBASE_MARKET=spot
# Optional override of futures product ids per symbol
# COINBASE_FUTURES_PRODUCTS=BTC/USD=BIP-20DEC30-CDE,ETH/USD=ETP-20DEC30-CDE

# Seconds a partly filled entry may keep working before its remainder is
# cancelled so the filled part can get its stop-loss (default 120)
# ENTRY_FILL_TIMEOUT_SECONDS=120

# Optional: Discord webhook URL for trade alerts
DISCORD_WEBHOOK_URL=

# Optional: Telegram alerts (BotFather token + destination chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
