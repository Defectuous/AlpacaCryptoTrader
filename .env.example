# Exchange: "alpaca" (paper or live, long only), "coinbase" (market data only for now)
# or "ibkr" (Interactive Brokers; spot long only, futures long and short)
BROKER=alpaca

# Coins to trade: comma-separated list, or "all" for every tradable USD coin on the broker
SYMBOLS=BTC/USD,ETH/USD

# Short entries in downtrends. Ignored (stays long-only) when the broker can't short.
ENABLE_SHORT_SELLING=false

# Alpaca API credentials
# Get these from https://alpaca.markets (paper trading is free)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to "true" for paper trading (safe, no real money), "false" for live
ALPACA_PAPER=true

# Dev machine only: key for fetch_history.py (local backtest price store).
# Use a separate Alpaca paper account so downloads never share the bot's rate limit.
# Leave unset on the Pi.
BACKTEST_ALPACA_API_KEY=
BACKTEST_ALPACA_SECRET_KEY=
# HISTORY_DIR=data/history

# Coinbase (framework only; see brokers/coinbase.py)
# "spot" = long only, "futures" = US perpetual-style futures, long and short
COINBASE_MARKET=spot
# Optional override of futures product ids per symbol
# COINBASE_FUTURES_PRODUCTS=BTC/USD=BIP-20DEC30-CDE,ETH/USD=ETP-20DEC30-CDE

# Interactive Brokers (TWS API). TWS or IB Gateway must be running, logged in,
# with API access enabled. Ports: Gateway 4002 paper / 4001 live, TWS 7497 / 7496.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
# Keep this fixed: the bot can only cancel orders placed under its own client id
IBKR_CLIENT_ID=17
# Account to trade; blank uses the first account of the login
IBKR_ACCOUNT=
# "true" refuses to start unless the login is a paper account (DU...)
IBKR_PAPER=true
# "spot" = PAXOS crypto, long only
# "futures" = CME Micro Bitcoin / Micro Ether futures, long AND short
IBKR_MARKET=spot
# Futures product per symbol (defaults shown)
# IBKR_FUTURES_PRODUCTS=BTC/USD=MBT,ETH/USD=MET
# Futures: close positions this many days before the contract expires
# IBKR_ROLL_DAYS=3
# 1 = live market data (needs a subscription), 3 = delayed (testing only)
# IBKR_MARKET_DATA_TYPE=1
# Coins tried for SYMBOLS=all on spot; unlisted ones are skipped
# IBKR_CRYPTO_SYMBOLS=BTC,ETH,LTC,BCH,SOL,XRP,ADA,DOGE,AVAX,LINK

# Seconds a partly filled entry may keep working before its remainder is
# cancelled so the filled part can get its stop-loss (default 120)
# ENTRY_FILL_TIMEOUT_SECONDS=120

# Optional: keep the trade journal in MySQL / MariaDB instead of logs/trade_journal.csv.
# On first start the table is created and an existing CSV journal is imported.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=trader
# DB_PASSWORD=
# DB_NAME=trading
# Fee % per fill for the journal's estimated fees and net P&L (default 0.25)
# TRADE_FEE_PCT=0.25

# Optional: Discord webhook URL for trade alerts
DISCORD_WEBHOOK_URL=

# Optional: Telegram alerts (BotFather token + destination chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert (Discord/Telegram) once when a position is up this many percent at the
# price it could be sold for now. Alert only; the bot's exits are unchanged.
# 0 disables (default 5)
# PROFIT_ALERT_PCT=5

# Profit trail: once a position is up PROFIT_TRAIL_ARM_PCT at its sellable
# price, let it ride but sell at market as soon as it falls PROFIT_TRAIL_PCT
# from its best price since then. The stop and 4h trend-flip exits still apply.
# These are the defaults for coins not in PROFIT_TARGETS_FILE; build that
# per-coin file with: python calibrate_profit_targets.py
# PROFIT_TRAIL_ARM_PCT=0 disables the default (defaults 7.1 and 2).
# PROFIT_TRAIL_ARM_PCT=7.1
# PROFIT_TRAIL_PCT=2
# Calibration: arm % = round-trip fees + this fraction of the coin's median
# best 7-day gain (defaults 0.5 and 0.66)
# PROFIT_TRAIL_FEE_PCT=0.5
# PROFIT_TRAIL_ARM_FRACTION=0.66
# PROFIT_TARGETS_FILE=profit_targets.json

# Trend reset: after a coin's position closes (any exit, including manual
# sells), don't buy it again until its 4h trend has left "uptrend" and come
# back. Stops the bot re-buying the tail of the run it just sold (default true)
# REENTRY_TREND_RESET=true

# Daily loss pause: after hitting the daily loss limit (3% / 5% of equity), stop
# new entries for this many hours. After that only losses closed since the pause
# count toward the limit; it all resets at local midnight (default 6)
# DAILY_LOSS_PAUSE_HOURS=6
# Quote re-check: between bar closes, re-run the entry checks every N minutes on
# the last closed bars with a fresh quote, so a setup blocked only by spread or
# slippage at the bar close gets another chance. 0 disables (default 15)
# QUOTE_RECHECK_MINUTES=15
